MONGO_URI=
PORT=1520
JWT_SECRET=

# Groq API key used server-side only by the Patient Support Chatbot.
# Get one from https://console.groq.com/keys — never commit the real value,
# never expose it to the frontend, and never return it in any API response.
GROQ_API_KEY=

# Optional: override the model used by the chatbot.
GROQ_MODEL=openai/gpt-oss-120b
